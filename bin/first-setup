#!/usr/bin/env bash
#
# Bootstrap a fresh machine (macOS or Linux):
#   1. Install packages (Homebrew on macOS, apt on Linux)
#   2. Install oh-my-zsh
#   3. Set zsh as the default shell
#   4. Run bin/install to symlink dotfiles
#   5. Apply macOS defaults (macOS only)

set -e

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${BASEDIR}"

OS="$(uname -s)"

# Request sudo access upfront and keep it alive throughout the script
if [ "${OS}" = "Darwin" ]; then
  echo "==> Requesting administrator access (required for Command Line Tools and shell changes)"
  sudo -v
  # Keep sudo alive in the background until the script finishes
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

echo "==> Installing packages"
case "${OS}" in
  Darwin)
    echo "==> Checking Command Line Tools"
    CLT_NEEDS_INSTALL=false

    if ! xcode-select -p &>/dev/null; then
      CLT_NEEDS_INSTALL=true
    else
      # Tools exist, but verify they're not outdated by checking if brew doctor would complain
      # We do this by attempting to get the CLT version - if they're too old, this will fail
      if ! pkgutil --pkg-info=com.apple.pkg.CLTools_Executables &>/dev/null; then
        echo "==> Command Line Tools appear incomplete or outdated"
        CLT_NEEDS_INSTALL=true
      else
        # Get macOS version and CLT version to check compatibility
        MACOS_VERSION=$(sw_vers -productVersion | cut -d. -f1)
        CLT_VERSION=$(pkgutil --pkg-info=com.apple.pkg.CLTools_Executables | awk '/version:/ {print $2}' | cut -d. -f1)

        # If CLT major version doesn't match macOS major version, they're outdated
        if [ "${CLT_VERSION}" != "${MACOS_VERSION}" ]; then
          echo "==> Command Line Tools version (${CLT_VERSION}) doesn't match macOS version (${MACOS_VERSION})"
          CLT_NEEDS_INSTALL=true
        fi
      fi
    fi

    if [ "${CLT_NEEDS_INSTALL}" = true ]; then
      echo "==> Reinstalling Command Line Tools"
      # Remove old tools first
      if [ -d /Library/Developer/CommandLineTools ]; then
        sudo rm -rf /Library/Developer/CommandLineTools
      fi
      # Trigger installation
      sudo xcode-select --install
      echo "==> Waiting for Command Line Tools installation to complete..."
      echo "    (A GUI dialog should have appeared - please complete the installation)"
      until xcode-select -p &>/dev/null; do
        sleep 5
      done

      # Wait for tools to be fully functional (not just present)
      echo "==> Waiting for Command Line Tools to be fully ready..."
      until pkgutil --pkg-info=com.apple.pkg.CLTools_Executables &>/dev/null; do
        sleep 5
      done
      echo "==> Command Line Tools installed"

      # Accept the license
      echo "==> Accepting Xcode license"
      sudo xcodebuild -license accept
    else
      echo "==> Command Line Tools are up to date"
    fi

    if ! command -v brew &>/dev/null; then
      echo "==> Installing Homebrew"
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      # Homebrew isn't on PATH yet in this shell (that normally happens via
      # ~/.zprofile, which isn't symlinked in until bin/install runs below).
      if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      else
        eval "$(/usr/local/bin/brew shellenv)"
      fi
    fi
    brew bundle --file="config/homebrew/Brewfile" --verbose
    ;;
  Linux)
    sudo apt-get update
    grep -vE '^\s*(#|$)' config/apt/packages.txt | xargs sudo apt-get install -y
    ;;
  *)
    echo "Unsupported OS: ${OS}" >&2
    exit 1
    ;;
esac

if [ ! -d "${HOME}/.oh-my-zsh" ]; then
  echo "==> Installing oh-my-zsh"
  # RUNZSH=no: don't drop into zsh when the installer finishes, let this script keep running.
  # CHSH=no: we set the default shell ourselves below, after zsh is guaranteed to be installed.
  # KEEP_ZSHRC=yes: don't overwrite ~/.zshrc, bin/install symlinks our own version afterwards anyway.
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "==> oh-my-zsh already installed, skipping"
fi

echo "==> Installing zsh-autosuggestions"
# Installed the same way on both platforms: oh-my-zsh's plugin loader expects
# it under $ZSH_CUSTOM/plugins, which neither brew nor apt places it in.
ZSH_CUSTOM="${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}"
if [ ! -d "${ZSH_CUSTOM}/plugins/zsh-autosuggestions" ]; then
  git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_CUSTOM}/plugins/zsh-autosuggestions"
else
  echo "==> zsh-autosuggestions already installed, skipping"
fi

echo "==> Setting zsh as the default shell"
ZSH_PATH="$(command -v zsh)"
# Homebrew's zsh isn't in /etc/shells by default; chsh refuses any shell that isn't listed there.
grep -qxF "${ZSH_PATH}" /etc/shells || echo "${ZSH_PATH}" | sudo tee -a /etc/shells >/dev/null
if [ "${SHELL}" != "${ZSH_PATH}" ]; then
  chsh -s "${ZSH_PATH}"
else
  echo "==> zsh is already the default shell, skipping"
fi

echo "==> Symlinking dotfiles"
bin/install

if [ "${OS}" = "Darwin" ]; then
  echo "==> Applying macOS defaults"
  bin/macos-defaults
fi

echo "==> Done"
